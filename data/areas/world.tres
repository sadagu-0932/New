[sub_resource type="Resource" id="npc_38"]
script = ExtResource("npc")
id = "miner"
display_name = "늙은 광부"
sprite = &"npc_miner"
lines = Array[String](["…거기 서라.", "그 옷. 숲 너머 연구소 것이지.", "뭘 하는 곳인지는 모른다. 알고 싶지도 않고.", "볼일 없으면 마을에 오래 머물지 마라."])
alt_flag = "golem_destroyed"
alt_lines = Array[String](["숲이 조용해졌더군.", "…네가 한 거냐. 고맙다는 말은 해 두지."])

[sub_resource type="Resource" id="npc_40"]
script = ExtResource("npc")
id = "homeless"
display_name = "집 잃은 주민"
sprite = &"npc_homeless"
lines = Array[String](["지붕째 뜯겨 나갔어.", "돌덩이 같은 게 걸어가더라고. 북쪽 숲으로.", "나무를 죄다 쓰러뜨리면서 갔어. 길이 났을 거야."])
alt_flag = ""
alt_lines = Array[String]([])

[sub_resource type="Resource" id="way_41"]
script = ExtResource("way")
id = "village"
display_name = "광산촌 탑"
reveals = Array[String]([])

[sub_resource type="Resource" id="npc_43"]
script = ExtResource("npc")
id = "child"
display_name = "아이"
sprite = &"npc_child"
lines = Array[String](["우와, 총이다! 진짜야?", "철길 따라왔어? 저쪽 큰 건물에서?", "거기 뭐가 있어? 어른들은 아무도 안 알려 줘."])
alt_flag = "golem_destroyed"
alt_lines = Array[String](["큰 돌덩이 이제 안 와? 진짜?", "…고마워. 근데 조금 무서워."])

[sub_resource type="Resource" id="npc_45"]
script = ExtResource("npc")
id = "afraid"
display_name = "겁먹은 주민"
sprite = &"npc_afraid"
lines = Array[String](["가, 가까이 오지 마…!", "어젯밤 그 커다란 것도 철길 쪽에서 왔어.", "집이 세 채나… 그건 북쪽 숲으로 갔어. 따라가지 마."])
alt_flag = ""
alt_lines = Array[String]([])

