[gd_resource type="Resource" script_class="AreaData" format=3]

[ext_resource type="Script" path="res://story/area_data.gd" id="area"]
[ext_resource type="Script" path="res://story/area_exit_data.gd" id="exit"]
[ext_resource type="Script" path="res://story/waystone_data.gd" id="way"]
[ext_resource type="Script" path="res://story/npc_data.gd" id="npc"]

[sub_resource type="Resource" id="exit_0"]
script = ExtResource("exit")
target_area = "village"
target_spawn = 2
required_flag = ""
locked_text = ""
end_text = ""

[sub_resource type="Resource" id="exit_1"]
script = ExtResource("exit")
target_area = "golem_lair"
target_spawn = 1
required_flag = ""
locked_text = ""
end_text = ""

[sub_resource type="Resource" id="way_0"]
script = ExtResource("way")
id = "forest_gate"
display_name = "숲 입구"
reveals = Array[String]([])

[sub_resource type="Resource" id="way_1"]
script = ExtResource("way")
id = "boss_gate"
display_name = "골렘 터 앞"
reveals = Array[String](["forest", "golem_lair"])

[resource]
script = ExtResource("area")
id = "forest"
display_name = "외곽 숲"
map_file = "res://levels/areas/forest.txt"
tileset = "tiles_forest"
on_map = true
map_pos = Vector2i(176, 58)
is_boss_room = false
boss_cleared_flag = ""
enter_story_id = "forest_enter"
enemy_overrides = {
"C": "charger_forest",
"S": "shooter_forest",
"B": "spreader_forest"
}
exits = Array[ExtResource("exit")]([SubResource("exit_0"), SubResource("exit_1")])
waystones = Array[ExtResource("way")]([SubResource("way_0"), SubResource("way_1")])
pickups = Array[String](["scrap", "heavy_gun"])
npcs = Array[ExtResource("npc")]([])
signs = Array[String](["이 앞, 큰 것이 지나간 자리"])
