[gd_resource type="Resource" script_class="ItemData" format=3]

[ext_resource type="Script" path="res://items/item_data.gd" id="item"]
[ext_resource type="Script" path="res://items/weapon_data.gd" id="weapon"]
[ext_resource type="Script" path="res://items/stat_mod.gd" id="mod"]
[ext_resource type="Script" path="res://combat/gun_data.gd" id="gun_s"]
[ext_resource type="Script" path="res://combat/melee_data.gd" id="melee_s"]
[ext_resource type="Script" path="res://combat/parry_data.gd" id="parry_s"]
[ext_resource type="Resource" path="res://data/projectiles/heavy_bullet.tres" id="bullet"]

[sub_resource type="Resource" id="gun"]
script = ExtResource("gun_s")
magazine_size = 6
start_ammo = 6
fire_interval_ticks = 18
muzzle_height = 2.5
muzzle_offset = 10.0
projectile = ExtResource("bullet")

[sub_resource type="Resource" id="melee"]
script = ExtResource("melee_s")
active_ticks = 14
recovery_ticks = 14
offset = 11.0
radius = 13.0
damage = 3
move_speed_mult = 0.4
ammo_on_hit = 1

[sub_resource type="Resource" id="parry"]
script = ExtResource("parry_s")
ammo_on_parry = 1
reflect_speed_mult = 1.6
reflect_damage = 3
reflect_lifetime_ticks = 180
perfect_window_ticks = 4
perfect_damage_mult = 2.0
perfect_radius_mult = 2.0
perfect_pierce = true

[sub_resource type="Resource" id="weapon"]
script = ExtResource("weapon")
gun = SubResource("gun")
melee = SubResource("melee")
parry = SubResource("parry")

[resource]
script = ExtResource("item")
id = "heavy_gun"
display_name = "중형 마석포"
description = "느리고 무겁다. 한 발이 세고,\n후려치면 넓게 크게 들어간다."
category = 0
icon = &"gun_heavy"
order = 2
weapon = SubResource("weapon")
stat_mods = Array[ExtResource("mod")]([])
