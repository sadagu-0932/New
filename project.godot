; Godot 프로젝트 설정.
; 수치(게임 밸런스)는 여기 두지 않고 res://data/ 에 둔다.
; 여기에는 엔진 설정(해상도·틱·입력 맵·충돌 레이어 이름)만 둔다.

config_version=5

[application]

config/name="Tutorial Demo (가제)"
config/description="2D 픽셀 탑다운 액션 슈팅 데모 - 튜토리얼 스피드런"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

DB="*res://core/db.gd"
Events="*res://core/events.gd"
Game="*res://core/game.gd"
PlayerInput="*res://core/player_input.gd"
Debug="*res://core/debug.gd"

[display]

window/size/viewport_width=320
window/size/viewport_height=180
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"

[gui]

theme/custom_font="res://art/fonts/Galmuri9.ttf"

[input]

move_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":65)
]
}
move_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":68)
]
}
move_up={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":87)
]
}
move_down={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":83)
]
}
shoot={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"button_index":1)
]
}
melee={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"button_index":2)
]
}
dodge={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":32)
]
}
skill={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":81)
]
}
interact={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":69)
]
}
restart={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":82)
]
}
pause={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194305)
]
}
skill_menu={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194306)
]
}
menu_confirm={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194309)
]
}
skill_select_1={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":49)
]
}
skill_select_2={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":50)
]
}
skill_select_3={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":51)
]
}
skill_select_4={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":52)
]
}
skill_select_5={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":53)
]
}
debug_hitboxes={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194332)
]
}
debug_god={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194333)
]
}
debug_prev_section={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194334)
]
}
debug_next_section={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194335)
]
}

[layer_names]

2d_physics/layer_1="world"
2d_physics/layer_2="player"
2d_physics/layer_3="enemy"
2d_physics/layer_4="player_hurtbox"
2d_physics/layer_5="enemy_hurtbox"
2d_physics/layer_6="player_attack"
2d_physics/layer_7="enemy_attack"
2d_physics/layer_8="pit"

[physics]

common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=8
common/physics_interpolation=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
